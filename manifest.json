{
  "name": "Mr.Green Signing",
  "description": "Redirects kiosk device to the correct signing page based on the device's Asset ID.",
  "icons": {
    "128": "icon128.png"
  },
  "version": "2.0.4",
  "manifest_version": 3,
  "kiosk_enabled": true,
  "storage": {
    "managed_schema": "schema.json"
  },
  "permissions": [
    "tabs",
    "storage",
    "enterprise.deviceAttributes"
  ],
  "background": {
    "service_worker": "background.js"
  }
}